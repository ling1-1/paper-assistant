# Paper Assistant environment example
# Copy this file to `.env.local` and fill only the variables you need.
# Never commit real secrets.

# Model providers
ANTHROPIC_API_KEY=your_anthropic_key
DEEPSEEK_API_KEY=your_deepseek_key
VOLC_API_KEY=your_volcengine_key
VOLC_MODEL=your_volcengine_endpoint
VOLC_FILE_MODEL=your_volcengine_file_model
DASHSCOPE_API_KEY=your_dashscope_key

# Default provider: claude | deepseek | doubao | qwen
DEFAULT_MODEL=doubao
